# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
#
# Every variable the app actually reads is listed here. Anything missing at runtime fails in a
# different way — some loudly, some (email) silently — so keep this file in step with the code.

# ── Database (Supabase PostgreSQL) ──────────────────────────────────────
# Get both URLs from: Supabase dashboard → Project Settings → Database → Connection string
# Pooled connection (for normal queries)
DATABASE_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=15"
# Direct connection (for Prisma migrations)
DIRECT_URL="postgresql://user:password@host/dbname?connect_timeout=15"

# ── NextAuth ────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# Your deployed URL (use http://localhost:3000 locally).
# Also the trusted base for verification links — never derived from the request Host header.
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional) ──────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Email (Resend) ───────────────────────────────────────────────────────
# From Resend dashboard → API Keys. The key is shown ONCE at creation — store it somewhere
# durable, because neither Resend nor Vercel can show it to you again.
# Without it, registration still returns an account but no verification email is sent, which
# leaves the user unable to log in. The sender domain (levelupflash.com) must stay verified in
# Resend for delivery to work.
RESEND_API_KEY="re_your-resend-api-key"

# ── Supabase client (image storage) ──────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ── Cloudinary (for image uploads in production) ─────────────────────────
# From Cloudinary dashboard → Settings → API Keys
# Leave these blank in local dev (will use local disk instead)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Admin ────────────────────────────────────────────────────────────────
# The one account allowed to change user roles. Must match that admin's login email exactly;
# role management returns 500 when it is unset.
SUPER_ADMIN_EMAIL="you@example.com"

# ── Cron (optional) ──────────────────────────────────────────────────────
# Shared secret for /api/keep-alive. If set, callers must present it; if unset, the route is open.
CRON_SECRET=""
